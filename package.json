{
  "name": "simon-design-system",
  "description": "A design system for Simon Movilidad built with React and MUI.",
  "private": false,
  "version": "0.1.9",
  "type": "module",
  "main": "dist/simon-design-system.cjs",
  "module": "dist/simon-design-system.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "postbuild": "node scripts/fix-css-name.mjs",
    "copy-tokens": "node scripts/copy-tokens.mjs",
    "prepublishOnly": "npm run build && npm run copy-tokens"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nuwsd-design-system.es.js",
      "require": "./dist/nuwsd-design-system.cjs"
    },
    "./styles": "./dist/design-system.css"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "9.39.1",
    "@mui/material": "^7.3.6",
    "@storybook/addon-docs": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@types/node": "24.10.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "storybook": "8.6.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "6.4.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "dependencies": {
    "@mui/icons-material": "^7.3.6"
  }
}
